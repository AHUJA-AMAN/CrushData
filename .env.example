# Crustdata API key (required): founder/company search, enrich, jobs, watchers
CRUSTDATA_API_KEY=

# Gemini (required): thesis parsing, memos, decisions, outreach drafts. _2/_3 are optional fallbacks on 429
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Tavily web search (optional): market context the memo cites as "web". Empty = memo uses Crustdata only
TAVILY_API_KEY=

# Gmail SMTP for outreach (optional). Empty = drafts are shown but nothing is sent
SMTP_EMAIL=
SMTP_PASSWORD=

# Team-owned inboxes that receive ALL outreach emails during the hackathon (comma-separated)
DEMO_RECIPIENTS=

# Where Crustdata watchers POST alerts: the FastAPI /webhook route via ngrok, e.g. https://abc.ngrok.app/webhook
WATCH_WEBHOOK_URL=

# true = serve every Crustdata call from the committed .cache/ (zero API calls, offline demo)
USE_CACHE=false
